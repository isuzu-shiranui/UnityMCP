# Text is stored with LF and checked out as the platform prefers. The source hash in
# scripts/source-hash.cs strips line endings before hashing for the same reason: without it the
# attestation written on Windows would never match what a Linux runner computes.
* text=auto eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.png   binary
*.jpg   binary
*.dll   binary
*.pdb   binary
*.unitypackage binary

# Native plugins. Git's own heuristic already treats a Mach-O or an ELF file as binary because
# of the NUL bytes in it, so nothing is broken without these; stating them keeps that heuristic
# from being what the protection rests on.
*.dylib  binary
*.so     binary
*.bundle binary
*.a      binary
*.jar    binary
*.aar    binary
