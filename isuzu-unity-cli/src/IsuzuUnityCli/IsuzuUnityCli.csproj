<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>isuzu-unity-cli</AssemblyName>
    <RootNamespace>IsuzuUnityCli</RootNamespace>
    <Version>4.0.2</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <TieredPGO>false</TieredPGO>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>isuzu-unity-cli</ToolCommandName>
    <PackageId>IsuzuUnityCli</PackageId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <!-- Every agent call pays process start. Native code starts in about 15 ms where the JIT
         took 120 and ReadyToRun 60; it also needs no runtime on the machine. A native binary
         can only be produced on its own OS, so the release builds each one on a matching runner. -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\skills\isuzu-unity-cli\SKILL.md" LogicalName="skills/isuzu-unity-cli/SKILL.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

</Project>
